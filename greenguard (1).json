        "jsCode": "const result = $json.results?.[0];\n\nif (!result) {\n  return {\n    json: {\n      valid: false,\n      common_name: \"Unknown\",\n      scientific_name: \"Unknown\",\n      confidence: 0,\n      co2: \"N/A\",\n      oxygen: \"N/A\",\n      uses: \"N/A\",\n      fact: \"No plant detected\"\n    }\n  };\n}\n\nreturn {\n  json: {\n    valid: true,\n    scientific_name: result.species.scientificName,\n    confidence: Math.round(result.score * 100)\n  }\n};"
