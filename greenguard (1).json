    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $input.item.json.body || $input.item.json;\n\nconst { type, input } = body;\n\n// ❌ Missing fields\nif (!type || !input) {\n  return {\n    json: {\n      valid: false,\n      common_name: \"Unknown\",\n      scientific_name: \"Unknown\",\n      confidence: 0,\n      co2: \"N/A\",\n      oxygen: \"N/A\",\n      uses: \"N/A\",\n      fact: \"Invalid input\"\n    }\n  };\n}\n\n// ❌ Invalid type\nif (type !== \"image\" && type !== \"text\") {\n  return {\n    json: {\n      valid: false,\n      common_name: \"Unknown\",\n      scientific_name: \"Unknown\",\n      confidence: 0,\n      co2: \"N/A\",\n      oxygen: \"N/A\",\n      uses: \"N/A\",\n      fact: \"Invalid type\"\n    }\n  };\n}\n\n// ❌ Invalid image URL\nif (type === \"image\") {\n  const isValidUrl = /^https?:\\/\\/.+/.test(input);\n\n  if (!isValidUrl) {\n    return {\n      json: {\n        valid: false,\n        common_name: \"Unknown\",\n        scientific_name: \"Unknown\",\n        confidence: 0,\n        co2: \"N/A\",\n        oxygen: \"N/A\",\n        uses: \"N/A\",\n        fact: \"Invalid image URL\"\n      }\n    };\n  }\n}\n\n// ❌ Invalid text input\nif (type === \"text\") {\n  if (typeof input !== \"string\" || input.trim().length < 2) {\n    return {\n      json: {\n        valid: false,\n        common_name: \"Unknown\",\n        scientific_name: \"Unknown\",\n        confidence: 0,\n        co2: \"N/A\",\n        oxygen: \"N/A\",\n        uses: \"N/A\",\n        fact: \"Invalid plant name\"\n      }\n    };\n  }\n}\n\n// ✅ VALID INPUT\nreturn {\n  json: {\n    valid: true,\n    type,\n    input: input.trim()\n  }\n};"
      },
