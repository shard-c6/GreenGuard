    {
      "parameters": {
        "jsCode": "let rawOutput = $json.output || $json.text || \"\";\n\n// 🧹 Remove markdown formatting\nrawOutput = rawOutput.replace(/```json|```/g, \"\").trim();\n\n// 🧠 Extract JSON if extra text exists\nconst jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n\nif (!jsonMatch) {\n  return {\n    json: {\n      valid: false,\n      common_name: \"Unknown\",\n      scientific_name: \"Unknown\",\n      confidence: 0,\n      co2: \"N/A\",\n      oxygen: \"N/A\",\n      uses: \"N/A\",\n      fact: \"No JSON found\"\n    }\n  };\n}\n\ntry {\n  const data = JSON.parse(jsonMatch[0]);\n\n  return {\n    json: {\n      valid: true,\n      ...data\n    }\n  };\n\n} catch (err) {\n  return {\n    json: {\n      valid: false,\n      common_name: \"Unknown\",\n      scientific_name: \"Unknown\",\n      confidence: 0,\n      co2: \"N/A\",\n      oxygen: \"N/A\",\n      uses: \"N/A\",\n      fact: \"Parsing error\"\n    }\n  };\n}"
