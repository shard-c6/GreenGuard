# Server
PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n AI Workflow
# Use /webhook-test/plant-detect while iterating on an inactive workflow.
# Switch to /webhook/plant-detect once the workflow is activated.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/plant-detect

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Upload Limits
MAX_FILE_SIZE_MB=5
MAX_IMAGES_PER_PLANT=3

# Admin Seed (used by seed script only)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_USERNAME=your-admin-username
